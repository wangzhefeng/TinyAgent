# ============================================================
# TinyAgent 环境配置模板：复制为 .env 并填入真实值（勿提交）
# ============================================================

# ---- LLM 主配置：智谱 BigModel · OpenAI 兼容端点 ----
# 文档: https://docs.bigmodel.cn/cn/guide/develop/openai/introduction
# 注意: Coding Plan 额度仅限官方指定工具；本项目脚本直连按量计费
LLM_PROVIDER=zhipu
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-zhipu-api-key
LLM_MODEL_ID=glm-4.7-flash
# LLM_MODEL_ID=glm-5.3-flash   # 质量档(¥0.8/¥2.8 每百万token)：免费档429拥堵或需更强质量时切换
LLM_TIMEOUT=60

# ---- 备用 provider：DeepSeek（按需使用，尽量不用）----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL_ID=deepseek-chat

# ---- Coding Plan · Anthropic 兼容端点（仅限指定工具如 Claude Code，项目不直用）----
ZHIPU_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_CODING_PLAN_MODEL=GLM-5.3-flash

# ---- 按需启用（取消注释并填值）----
# GOOGLE_SERPER_API_KEY=        # L1 手写 ReAct 的搜索工具
# OPENAI_API_KEY=               # L3 LangGraph 课程默认栈（可选）
# MODELSCOPE_API_KEY=           # hello_agents 旧接口（迁移期兼容）
